<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pro.surpin</groupId>
        <artifactId>arrow-flight-connectors</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>trino-arrow-flight</artifactId>
    <packaging>trino-plugin</packaging>

    <name>Trino Arrow Flight SQL connector</name>

    <properties>
        <!-- which per-SPI source root supplies ArrowFlightPageSource; switched by the profiles below -->
        <trino.compat.src>src/trino-455/java</trino.compat.src>
        <!-- must match the slice the target trino-spi was built with -->
        <dep.slice.version>2.3</dep.slice.version>
    </properties>

    <dependencies>
        <!-- shared engine-neutral Flight client -->
        <dependency>
            <groupId>pro.surpin</groupId>
            <artifactId>arrow-flight-common</artifactId>
        </dependency>

        <!-- provided by the Trino engine -->
        <dependency>
            <groupId>io.trino</groupId>
            <artifactId>trino-spi</artifactId>
            <version>${dep.trino.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>slice</artifactId>
            <version>${dep.slice.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- declared explicitly by the trino-455 profile, where it is SPI -->
                <exclusion>
                    <groupId>org.openjdk.jol</groupId>
                    <artifactId>jol-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.18.2</version>
            <scope>provided</scope>
        </dependency>
        <!-- part of the Trino SPI surface: transitive from trino-spi, must not be bundled -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.41.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-context</artifactId>
            <version>1.41.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- bundled into the plugin -->
        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>bootstrap</artifactId>
            <version>${dep.airlift.version}</version>
        </dependency>
        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>configuration</artifactId>
            <version>${dep.airlift.version}</version>
        </dependency>
        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>log</artifactId>
            <version>${dep.airlift.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
            <version>${dep.guice.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.trino</groupId>
                <artifactId>trino-maven-plugin</artifactId>
                <!-- version repeated here (not only in parent pluginManagement) so Maven can
                     resolve the 'trino-plugin' packaging extension during project scan on a
                     cold ~/.m2, e.g. inside a fresh build container -->
                <version>24</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-trino-compat-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${trino.compat.src}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      One plugin build per Trino SPI line; a plugin built for one line does NOT load/run on another.
      The per-line adapters (page source, split manager, page source provider) are in src/trino-<line>.
        mvn clean package               -> Trino 455 (default; JDK 22+ at runtime)
        mvn clean package -Ptrino-477   -> Trino 477 (JDK 24+ at runtime)
        mvn clean package -Ptrino-483   -> Trino 483 (JDK 25+ at runtime)
    -->
    <profiles>
        <profile>
            <id>trino-455</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <!-- part of the 455 SPI surface; no longer an SPI dependency in later releases -->
                <dependency>
                    <groupId>org.openjdk.jol</groupId>
                    <artifactId>jol-core</artifactId>
                    <version>0.17</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>trino-477</id>
            <properties>
                <dep.trino.version>477</dep.trino.version>
                <maven.compiler.release>24</maven.compiler.release>
                <trino.compat.src>src/trino-477/java</trino.compat.src>
                <dep.slice.version>2.4</dep.slice.version>
            </properties>
        </profile>
        <profile>
            <id>trino-483</id>
            <properties>
                <dep.trino.version>483</dep.trino.version>
                <maven.compiler.release>25</maven.compiler.release>
                <trino.compat.src>src/trino-483/java</trino.compat.src>
                <dep.slice.version>2.8</dep.slice.version>
            </properties>
            <!--
              Trino 483's JSON mapper uses Jackson Blackbird, which generates creator code inside the
              plugin's own classloader. That code needs Blackbird (and a matching jackson-databind)
              visible from the plugin, exactly like Trino's bundled plugins ship it; otherwise every
              task fails with NoClassDefFoundError: .../blackbird/deser/CreatorOptimizer.
              Versions track trino-server-483/lib (Jackson 2.22.1).
            -->
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>com.fasterxml.jackson</groupId>
                        <artifactId>jackson-bom</artifactId>
                        <version>2.22.1</version>
                        <type>pom</type>
                        <scope>import</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
            <dependencies>
                <dependency>
                    <groupId>com.fasterxml.jackson.module</groupId>
                    <artifactId>jackson-module-blackbird</artifactId>
                    <version>2.22.1</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
